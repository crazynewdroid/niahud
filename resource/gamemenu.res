"resource/gamemenu.res"
{
	"NiaHud"
	{
		"label"									"NiaHUD"
		"command"								"engine con_enable 1; toggleconsole; echo Even when trapped by the cycle of karma,; echo the dreams we left behind will open the door!; echo Even if the infinite universe stands in our way,; echo the seething of our blood will determine what will be!; echo We'll break though time and space to grab hold of our own path!; echo Tengen Toppa Gurren Lagann; echo Who the hell do you think we are?!"
	}
	"Servers"
	{
		"label"									"servers"
		"command"								"OpenServerBrowser"
	}
	"Create"
	{
		"label"									"create"
		"command"								"OpenCreateMultiplayerGameDialog"
		"OnlyAtMenu"							"1"
	}
	"Items"
	{
		"label"									"items"
		"command"								"engine open_charinfo"
	}
	"Options"
	{
		"label"									"options"
		"command"								"OpenOptionsDialog"
	}
	"Advanced Options"
	{
		"label"									"adv.options"
		"command"								"opentf2options"
	}
	"Contracker"
	{
		"label"									"contracker"
		"command"								"questlog"
	}
	"Vote"
	{
		"label"									"vote"
		"command"								"callvote"
		"OnlyInGame"							"1"
	}
	"Mute"
	{
		"label"									"mute"
		"command"								"OpenMutePlayerDialog"
		"OnlyInGame"							"1"
	}
	"Disconnect"
	{
		"label"									"disconnect"
		"command"								"engine disconnect"
		"OnlyInGame"							"1"
	}
	"Quit"
	{
		"label"									"quit"
		"command"								"engine replay_confirmquit"
		"OnlyAtMenu"							"1"
	}
}